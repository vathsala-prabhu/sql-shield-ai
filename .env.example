# SQL SHIELD AI - Environment Configuration

# Flask secret key for sessions and CSRF protection
FLASK_SECRET_KEY=sql-shield-dev-secret-key-change-in-production

# Decision threshold for ML SQL injection classification (0.0 - 1.0)
# Scores at or above this threshold will be blocked by the security gateway
SHIELD_THRESHOLD=0.5

# Active ML model to use for primary detection (selected_model, random_forest, or xgboost)
SHIELD_ACTIVE_MODEL=selected_model

# Optional Gemini API key for the AI Security Analyst
# If left blank, the system automatically uses an intelligent local rule-based fallback engine
GEMINI_API_KEY=

# Preferred Gemini model name for online analysis
GEMINI_MODEL=gemini-2.5-flash

# Maximum query character length permitted for analysis
SHIELD_MAX_QUERY_LEN=5000

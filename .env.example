
# SQL SHIELD AI - Environment Configuration

# Flask secret key for sessions and CSRF protection
FLASK_SECRET_KEY=replace_with_a_random_secret

# Decision threshold for ML SQL injection classification (0.0 - 1.0)
SHIELD_THRESHOLD=0.5

# Active ML model: selected_model, random_forest, or xgboost
SHIELD_ACTIVE_MODEL=selected_model

# Optional AI provider keys
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Maximum query character length permitted for analysis
SHIELD_MAX_QUERY_LEN=5000
